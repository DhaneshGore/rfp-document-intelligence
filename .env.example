# Copy to .env and fill in. Never commit .env.

# ---- OpenRouter (free models only) -------------------------------------------
OPENROUTER_API_KEY=
# Comma-separated or JSON list. Every model must end with ":free"; zero pricing is
# re-verified at runtime against https://openrouter.ai/api/v1/models.
LLM_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,thinkingmachines/inkling:free,nvidia/nemotron-3.5-lightning:free
LLM_DEFAULT_MODEL=google/gemma-4-31b-it:free
# Optional explicit fallbacks (also free). Empty = no fallback.
LLM_FALLBACK_MODELS=
LLM_VERIFY_FREE=true
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048
# OpenRouter `reasoning.effort` for reasoning models ("" to omit): low | medium | high
LLM_REASONING_EFFORT=low

# ---- Paths --------------------------------------------------------------------
# Folder whose sub-folders are bids; BID_FOLDER_GLOB selects them for `index --all`.
BIDS_ROOT=.
BID_FOLDER_GLOB=Bid*
DATA_DIR=data
UPLOADS_DIR=data/uploads
INDEX_DIR=data/index

# ---- Ingestion ----------------------------------------------------------------
PDF_PARSER_BACKEND=docling
PDF_OCR_ENABLED=true
MAX_UPLOAD_MB=25

# ---- Chunking -----------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MAX_TABLE_CHUNK_SIZE=2400

# ---- Embeddings & retrieval ---------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DEFAULT_SEARCH_MODE=hybrid_rerank
CANDIDATE_POOL=30
RRF_K=60
QUERY_EXPANSION=true

# ---- Services -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
